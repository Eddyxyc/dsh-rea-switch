{
  "name": "dsh-rea-switch",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "DSH Plugins-page tab: a master switch that turns REA off entirely, plus a switch between the full and the compact REA MCP tool set",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Eddyxyc/dsh-rea-switch.git"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/en.json",
    "locale/zh.json",
    "icon.svg",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-api-remotes",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-plugin-manager"
      ]
    }
  }
}
